<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SOP_UI.Site"%>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>SOP Manufacturing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/navbar-menu.css" />
    <style>
        body {
            padding-top: 80px;
        }
        .home-page {
            padding-top: 0 !important;
        }
        /* NAVBAR */
        
        .custom-navbar {
            position: fixed;   /* 🔥 ini kunci */
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
            background: transparent;
            backdrop-filter: none;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }

        /* MODE TRANSPARENT (HOME) */
        .navbar-transparent {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;
            background: transparent !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
        }

        /* TEXT PUTIH */
        .navbar-transparent .nav-link,
        .navbar-transparent .navbar-brand span {
            color: #fff !important;
        }
        /* HOVER */
        .navbar-transparent .nav-link:hover {
            background: rgba(255,255,255,0.15);
            color: #fff !important;
        }
        /* ACTIVE */
        .navbar-nav .nav-link.active {
            background: #0d6efd;
            color: white !important;
        }

        /* SCROLLED versi transparan → transisi ke putih */
        .navbar-transparent.scrolled {
            background: rgba(255,255,255,0.98) !important;
            backdrop-filter: blur(10px) !important;
        }

        .navbar-transparent.scrolled .nav-link:not(.active),
        .navbar-transparent.scrolled .navbar-brand span {
            color: #1e293b !important;
        }

        .navbar-transparent.scrolled .nav-link:not(.active):hover {
            background: rgba(13,110,253,0.08) !important;
            color: #0d6efd !important;
        }

        /* ================= DROPDOWN — GANTI MULAI SINI ================= */
        .dropdown-menu {
            border-radius: 14px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.12);
            border: 1px solid rgba(0,0,0,0.05);
            padding: 8px;
            min-width: 260px;
            animation: dropFade 0.18s ease;
        }

        @keyframes dropFade {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .dropdown-item {
            border-radius: 10px;
            padding: 10px 14px;
            transition: 0.15s ease;
            white-space: normal;
        }

        .dropdown-item .menu-label {
            display: flex;
            flex-direction: column;
            text-align: left;
            line-height: 1.35;
        }

        .dropdown-item:hover,
        .dropdown-item:focus {
            background: #f1f5fb;
            color: #0d6efd;
        }

        .dropdown-item .menu-main {
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
        }

        .dropdown-item .menu-sub {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .dropdown-item:hover .menu-main {
            color: #0d6efd;
        }

        .dropdown-menu li + li {
            border-top: 1px solid #f1f5f9;
        }

        .dropdown-menu li:first-child {
            border-top: none;
        }

        /* SUBMENU (LEVEL 3) */
        .dropdown-submenu {
            position: relative;
        }

        /* toggle-nya sendiri jadi row: label kiri, panah kanan */
        .dropdown-submenu > .dropdown-item.dropdown-toggle {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        /* matikan caret bawaan Bootstrap supaya tidak dobel sama panah custom */
        .dropdown-submenu > .dropdown-item.dropdown-toggle::after {
            display: none;
        }

        .dropdown-submenu > .dropdown-item.dropdown-toggle .submenu-arrow {
            font-size: 11px;
            color: #94a3b8;
            flex-shrink: 0;
        }

        .dropdown-submenu .dropdown-menu {
            top: 0;
            left: 100%;
            margin-left: 6px;
        }

        @media (max-width: 992px) {
            .dropdown-submenu .dropdown-menu {
                position: static;
                left: 0;
                margin-left: 0;
                box-shadow: none;
                border: none;
                background: #f8fafc;
            }
        }
        /* ================= DROPDOWN — GANTI SAMPAI SINI ================= */

        /* SHOW ON HOVER */
        .dropdown:hover > .dropdown-menu {
            display: block;
        }
        @media (max-width: 768px) {
            .navbar-brand img {
                height: 26px;
            }
        }
        .navbar-brand img {
            transition: 0.3s;
        }
        .navbar-brand:hover img {
            transform: scale(1.05);
        }
        /* DEFAULT (semua halaman) */
        .logo-img {
            height: 52px;
            transition: all 0.3s ease;
        }
        /* KHUSUS HOME */
        .home-page .logo-img {
            height: 82px;
            transform: scale(1.05);
        }
        /* RESPONSIVE */
        @media (max-width: 768px) {
            .home-page .logo-img {
                height: 50px;
            }
            .logo-img {
                height: 28px;
            }
        }
        .custom-navbar.scrolled {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(10px);
            box-shadow: 0 6px 25px rgba(0,0,0,0.12);
        }
    </style>
</head>

<body id="bodyTag" runat="server">
<form runat="server">
    <nav id="navbar" runat="server" class="navbar navbar-expand-lg custom-navbar">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="<%= ResolveUrl("~/assets/img/logoYongjin.png") %>" class="logo-img" />
            </a>

            <!-- MOBILE TOGGLE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto" id="menuContainer" runat="server"></ul>

                <!-- USER / LOGOUT -->
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            👤 <asp:Literal ID="litUsername" runat="server" />
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="<%= ResolveUrl("~/Logout.aspx") %>">🚪 Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <!-- 🔥 CONTENT -->
    <div class="content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>

</form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll('.dropdown-submenu > a').forEach(function (el) {
                el.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    let submenu = this.nextElementSibling;

                    if (submenu) {
                        submenu.classList.toggle('show');
                    }
                });
            });

        });

        function updateNavbarOnScroll() {
            const navbar = document.getElementById("navbar");

            if (window.scrollY > 50) {
                navbar.classList.add("scrolled");
            } else {
                navbar.classList.remove("scrolled");
            }
        }

        window.addEventListener("scroll", updateNavbarOnScroll);
        updateNavbarOnScroll(); // set state awal saat load, misal reload saat halaman sudah di-scroll
    </script>
</body>
</html>
